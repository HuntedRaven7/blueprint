#!/usr/bin/env bash

set -euo pipefail

NAME="${1:-ubuntu}"
UNIT="${NAME}.service"
ICON="applications-terminal"
DISPLAY_NAME="${NAME^}"

notify-send -i "${ICON}" "${DISPLAY_NAME}" "Please wait for your ${NAME} container"

systemctl --user daemon-reload
if ! systemctl --user start "${UNIT}"; then
    notify-send -u critical -i dialog-error "${DISPLAY_NAME}" "Failed to start ${NAME} container"
    exit 1
fi

ready=0
for _ in $(seq 1 120); do
    if podman container exists "${NAME}" 2>/dev/null &&
        [[ "$(podman inspect -f '{{.State.Running}}' "${NAME}" 2>/dev/null)" == "true" ]]; then
        ready=1
        break
    fi
    sleep 1
done

if [[ "${ready}" -ne 1 ]]; then
    notify-send -u critical -i dialog-error "${DISPLAY_NAME}" "Timed out waiting for ${NAME} container"
    exit 1
fi

notify-send -i "${ICON}" "${DISPLAY_NAME}" "${NAME} container ready"

CMD=(podman exec -it "${NAME}" bash)

# Prefer the spec-compliant universal launcher if available. Its options must
# be monolithic (--title=VALUE); a bare "--title VALUE" is discarded as an
# unknown option and the title is then misparsed as the command to run.
if command -v xdg-terminal-exec >/dev/null 2>&1; then
    if xdg-terminal-exec "--title=${DISPLAY_NAME}" -- "${CMD[@]}"; then
        exit 0
    fi
fi

# Ordered fallback list of terminal emulators. Each entry is
# "binary|sep|title-flag" where:
#   sep "e" => binary [title-flag TITLE] -e COMMAND...
#   sep "d" => binary [title-flag TITLE] -- COMMAND...
TERMINALS=(
    "konsole|e|--title"
    "kitty|e|--title"
    "ghostty|e|--title"
    "alacritty|e|--title"
    "foot|e|-T"
    "gnome-terminal|d|--title"
    "kgx|d|"
    "xterm|e|-T"
)

for spec in "${TERMINALS[@]}"; do
    binary="${spec%%|*}"
    rest="${spec#*|}"
    sep="${rest%%|*}"
    title_flag="${rest##*|}"

    if ! command -v "${binary}" >/dev/null 2>&1; then
        continue
    fi

    args=("${binary}")
    if [[ -n "${title_flag}" ]]; then
        args+=("${title_flag}" "${DISPLAY_NAME}")
    fi
    if [[ "${sep}" == "e" ]]; then
        args+=(-e "${CMD[@]}")
    else
        args+=(-- "${CMD[@]}")
    fi

    # Run (don't exec) so a failing terminal falls through to the next one.
    if "${args[@]}"; then
        exit 0
    fi
done

notify-send -u critical -i dialog-error "${DISPLAY_NAME}" "No terminal emulator found"
exit 1
